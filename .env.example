# Copy to .env and adjust. docker compose reads .env automatically.
# Every value here has a working default, so .env is optional for a demo.

DB_NAME=claims
DB_USER=claims
DB_PASSWORD=claims
DB_PORT_HOST=54321

# Must be at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-this-is-a-demo-secret-key-32b
JWT_TTL_MINUTES=480

FRONTEND_PORT=9000
BACKEND_PORT=9090

# Leave empty in Docker: nginx proxies /api so there is no cross-origin request.
# Set to http://localhost:5173 when running the Vite dev server directly.
CORS_ALLOWED_ORIGINS=
